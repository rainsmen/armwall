[Unit]
Description=Restore ArmWall transparent gateway
After=network-online.target armwall-sing-box.service
Wants=network-online.target armwall-sing-box.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/armwall-gateway restore
ExecReload=/usr/local/bin/armwall-gateway reload
ExecStop=/usr/local/bin/armwall-gateway suspend
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
