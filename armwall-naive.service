[Unit]
Description=ArmWall NaiveProxy clients
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/armwall-naive-supervisor
Restart=always
RestartSec=3
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/armwall/naive
ReadWritePaths=/var/log/armwall

[Install]
WantedBy=multi-user.target
