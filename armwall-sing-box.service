[Unit]
Description=ArmWall sing-box proxy
After=network-online.target armwall-naive.service
Wants=network-online.target armwall-naive.service
[Service]
ExecStart=/usr/local/bin/sing-box run -c /etc/armwall/sing-box.json
StandardOutput=append:/var/log/armwall/sing-box.log
StandardError=append:/var/log/armwall/sing-box.log
Restart=on-failure
RestartSec=3
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/armwall
ReadWritePaths=/var/log/armwall /var/lib/armwall
[Install]
WantedBy=multi-user.target
