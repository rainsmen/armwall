[Unit]
Description=ArmWall web management service
After=network-online.target
Wants=network-online.target
[Service]
ExecStart=/usr/local/bin/armwall
Environment=ARMWALL_LISTEN=0.0.0.0:8080
Environment=ARMWALL_PROXY_PORT=11080
Environment=ARMWALL_TPROXY=1
Environment=ARMWALL_TPROXY_PORT=11081
EnvironmentFile=-/etc/armwall/armwall.env
UMask=0027
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
